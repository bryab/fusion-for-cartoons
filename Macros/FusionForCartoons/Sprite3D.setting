					Default = 1,
				}
			},
			Outputs = {
				Output1 = InstanceOutput {
					SourceOp = "singleParticleTransform",
					Source = "Output",
					Name = "Output",
				}
			},
			ViewInfo = GroupInfo {
				Pos = { 484, 139 },
				Flags = {
					Expanded = true,
					AllowPan = false,
					AutoSnap = true,
					RemoveRouters = true
				},
				Size = { 126, 130.3, 63, 22 },
				Direction = "Horizontal",
				PipeStyle = "Direct",
				Scale = 1,
				Offset = { 0, 0 }
			},
			Tools = ordered() {
				singleParticleRender = pRender {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						_MotionBlurWarning = Input { Disabled = true, },
						Width = Input { Value = 2048, },
						Height = Input { Value = 858, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						OutputMode = Input { Disabled = true, },
						["MaterialID.Nest"] = Input { Value = 1, },
						["MaterialID.MaterialID"] = Input { Value = 88, },
						["ObjectID.Nest"] = Input { Value = 1, },
						["ObjectID.ObjectID"] = Input { Value = 88, },
						Input = Input {
							SourceOp = "singleParticleEmitter",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 0, 43.1501 } },
				},
				singleParticleEmitter = pEmitter {
					ID = 263,
					NameSet = true,
					Inputs = {
						Number = Input { Value = 1, },
						Lifespan = Input { Value = 1, },
						Style = Input { Value = FuID { "ParticleStyleBitmap" }, },
						["ParticleStyle.Size"] = Input { Value = 1, },
						["SphereRgn.Size"] = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 0, 10.15 } },
				},
				singleParticleTransform = Transform3D {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						SceneInput = Input {
							SourceOp = "singleParticleRender",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 0, 76.15 } },
				}
